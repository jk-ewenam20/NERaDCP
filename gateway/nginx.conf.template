# Re-resolve upstream hostnames on every request via Google DNS.
# Required when proxy_pass uses a variable (which enables per-request resolution
# instead of caching the IP at startup - important for Render's load balancers).
resolver 8.8.8.8 8.8.4.4 ipv6=off valid=30s;

server {
    listen ${PORT};

    # Generous timeouts to survive free-tier cold starts (30-50 s wake-up)
    proxy_connect_timeout  90s;
    proxy_read_timeout     90s;
    proxy_send_timeout     90s;

    # SSL settings for HTTPS upstreams
    proxy_ssl_verify      off;
    proxy_ssl_server_name on;

    # Strip upstream CORS headers so we set our own without duplicates
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Allow-Credentials;

    # ── Health check ──────────────────────────────────────────────────────────
    location = / {
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    # ── Auth Service ──────────────────────────────────────────────────────────
    location /api/v1/auth/ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin'  '${FRONTEND_URL}';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type';
            add_header 'Access-Control-Max-Age'       '86400';
            return 204;
        }
        add_header 'Access-Control-Allow-Origin'  '${FRONTEND_URL}' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type' always;
        set $auth ${AUTH_SERVICE_URL};
        proxy_pass       $auth;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Analytics Service ─────────────────────────────────────────────────────
    location /api/v1/analytics/ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin'  '${FRONTEND_URL}';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type';
            add_header 'Access-Control-Max-Age'       '86400';
            return 204;
        }
        add_header 'Access-Control-Allow-Origin'  '${FRONTEND_URL}' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type' always;
        set $analytics ${ANALYTICS_SERVICE_URL};
        proxy_pass       $analytics;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Tracking Service - WebSocket ──────────────────────────────────────────
    location /socket.io/ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin'  '${FRONTEND_URL}';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type';
            add_header 'Access-Control-Max-Age'       '86400';
            return 204;
        }
        add_header 'Access-Control-Allow-Origin' '${FRONTEND_URL}' always;
        set $tracking ${TRACKING_SERVICE_URL};
        proxy_pass          $tracking;
        proxy_http_version  1.1;
        proxy_set_header    Upgrade     $http_upgrade;
        proxy_set_header    Connection  "upgrade";
        proxy_set_header    Host        $proxy_host;
        proxy_cache_bypass  $http_upgrade;
    }

    # ── Tracking Service - REST ───────────────────────────────────────────────
    location /api/v1/tracking/ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin'  '${FRONTEND_URL}';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type';
            add_header 'Access-Control-Max-Age'       '86400';
            return 204;
        }
        add_header 'Access-Control-Allow-Origin'  '${FRONTEND_URL}' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type' always;
        set $tracking ${TRACKING_SERVICE_URL};
        proxy_pass       $tracking;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Incident Service - catch-all ──────────────────────────────────────────
    location /api/v1/ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin'  '${FRONTEND_URL}';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type';
            add_header 'Access-Control-Max-Age'       '86400';
            return 204;
        }
        add_header 'Access-Control-Allow-Origin'  '${FRONTEND_URL}' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type' always;
        set $incident ${INCIDENT_SERVICE_URL};
        proxy_pass       $incident;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
