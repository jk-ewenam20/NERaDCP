server {
    listen ${PORT};

    # Increase timeouts for cold-start wake-up on free tier
    proxy_connect_timeout 60s;
    proxy_read_timeout    60s;
    proxy_send_timeout    60s;

    # ── Auth Service ──────────────────────────────────────────────────────────
    location /api/v1/auth/ {
        proxy_pass          ${AUTH_SERVICE_URL};
        proxy_ssl_server_name on;
        proxy_set_header    Host              $proxy_host;
        proxy_set_header    X-Real-IP         $remote_addr;
        proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
    }

    # ── Analytics Service ─────────────────────────────────────────────────────
    location /api/v1/analytics/ {
        proxy_pass          ${ANALYTICS_SERVICE_URL};
        proxy_ssl_server_name on;
        proxy_set_header    Host              $proxy_host;
        proxy_set_header    X-Real-IP         $remote_addr;
        proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
    }

    # ── Tracking Service - WebSocket (must come before REST location) ─────────
    location /socket.io/ {
        proxy_pass              ${TRACKING_SERVICE_URL};
        proxy_ssl_server_name   on;
        proxy_http_version      1.1;
        proxy_set_header        Upgrade     $http_upgrade;
        proxy_set_header        Connection  "upgrade";
        proxy_set_header        Host        $proxy_host;
        proxy_cache_bypass      $http_upgrade;
    }

    # ── Tracking Service - REST ───────────────────────────────────────────────
    location /api/v1/tracking/ {
        proxy_pass          ${TRACKING_SERVICE_URL};
        proxy_ssl_server_name on;
        proxy_set_header    Host              $proxy_host;
        proxy_set_header    X-Real-IP         $remote_addr;
        proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
    }

    # ── Incident Service - catch-all for remaining /api/v1/* routes ───────────
    # Handles: /api/v1/incidents/, /api/v1/hospitals/, /api/v1/ambulances/,
    #          /api/v1/police-stations/, /api/v1/fire-stations/
    location /api/v1/ {
        proxy_pass          ${INCIDENT_SERVICE_URL};
        proxy_ssl_server_name on;
        proxy_set_header    Host              $proxy_host;
        proxy_set_header    X-Real-IP         $remote_addr;
        proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
    }
}
