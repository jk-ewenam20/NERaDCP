    <mxCell id="gateway_routes" value="• /api/v1/auth/* → Auth Service :3001&#xa;• /api/v1/hospitals/*, /ambulances/*, /police-*, /fire-* → Responder Service :3002&#xa;• /api/v1/incidents/* → Incident Service :3003&#xa;• /api/v1/vehicles/* → Tracking Service :3004 | /socket.io/* → Tracking Service :3004 (WS)&#xa;• /api/v1/analytics/* → Analytics Service :3005" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#b0c4de;" vertex="1" parent="1">
